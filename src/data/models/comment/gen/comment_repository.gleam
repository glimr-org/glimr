pub fn update(
  pool pool: Pool,
  body body: String,
  is_approved is_approved: Bool,
  updated_at updated_at: Int,
  id id: Int,
) -> Result(UpdateRow, DbError) {
  case pool.checkout(pool) {
    Ok(conn) -> {
      let result =
        update_wc(
          conn: conn,
          body: body,
          is_approved: is_approved,
          updated_at: updated_at,
          id: id,
        )
      pool.release(pool, conn)
      result
    }
    Error(e) -> Error(e)
  }
}

pub fn update_wc(
  conn conn: Connection,
  body body: String,
  is_approved is_approved: Bool,
  updated_at updated_at: Int,
  id id: Int,
) -> Result(UpdateRow, DbError) {
  case
    query.select_all(
      conn,
      "UPDATE comments SET body = $1, is_approved = $2, updated_at = $3 WHERE id = $4 RETURNING *",
      [
        connection.string(body),
        connection.bool(is_approved),
        connection.int(updated_at),
        connection.int(id),
      ],
      update_row_decoder(),
    )
  {
    Ok([row]) -> Ok(row)
    Ok([]) -> Error(NotFound)
    Ok(_) -> Error(connection.QueryError("Expected single row"))
    Error(e) -> Error(e)
  }
}

