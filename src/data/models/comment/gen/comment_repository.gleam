pub fn upsert(
  pool pool: Pool,
  id id: Int,
  user_id user_id: Int,
  post_id post_id: Int,
  body body: String,
  is_approved is_approved: Bool,
  created_at created_at: Int,
  updated_at updated_at: Int,
) -> Result(UpsertRow, DbError) {
  case pool.checkout(pool) {
    Ok(conn) -> {
