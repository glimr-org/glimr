          conn: conn,
          id: id,
          user_id: user_id,
          post_id: post_id,
          body: body,
          is_approved: is_approved,
          created_at: created_at,
          updated_at: updated_at,
        )
      pool.release(pool, conn)
      result
    }
    Error(e) -> Error(e)
  }
