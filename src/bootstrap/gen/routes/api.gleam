import gleam/http.{Get}
import gleam/json
import glimr/response/response
import wisp

pub fn routes(path, method, req, ctx) {
  case path {
    ["welcome"] ->
      case method {
        Get ->
          {
            fn(_req, _ctx) {
              json.string("Welcome to Glimr ✨")
              |> response.json(200)
            }
          }(req, ctx)
        _ -> wisp.method_not_allowed([Get])
      }

    _ -> wisp.not_found()
  }
}
