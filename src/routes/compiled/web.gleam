pub fn routes(path, method, req, ctx) {
  case path {
    [] ->
      case method {
        Get ->
          {
            fn(_req, _ctx) {
              view.build()
              |> view.html("welcome.html")
              |> view.render()
            }
          }(req, ctx)
        _ -> wisp.method_not_allowed([Get])
      }

    _ -> wisp.not_found()
  }
}
